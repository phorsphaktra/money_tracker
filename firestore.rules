rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /stats/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /monthly_tracker/{userId}/transactions/{transactionId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/tasks/{taskId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    match /users/{userId}/projects/{projectId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    function isSignedIn() {
      return request.auth != null;
    }
    
    function isProjectMember(projectData) {
      return isSignedIn() && 
        (projectData.members.hasAny([request.auth.uid]) || 
         projectData.createdBy == request.auth.uid);
    }

    function isValidTask() {
      let incoming = request.resource.data;
      return incoming.title is string &&
        incoming.title.size() > 0 &&
        incoming.projectId is string &&
        incoming.status in ['initial', 'in_progress', 'review', 'completed', 'blocked'] &&
        incoming.priority in ['Low', 'Medium', 'High'];
    }

    function isValidTaskUpdate() {
      let incoming = request.resource.data;
      let existing = resource.data;
      let statusTransitions = {
        'initial': ['in_progress', 'blocked'],
        'in_progress': ['review', 'blocked'],
        'review': ['completed', 'in_progress', 'blocked'],
        'blocked': ['in_progress'],
        'completed': ['in_progress']
      };
      
      return incoming.diff(existing).affectedKeys()
        .hasOnly(['status', 'title', 'description', 'priority', 'dueDate', 'assignedTo', 'updatedAt']) &&
        (
          !incoming.diff(existing).affectedKeys().hasAny(['status']) ||
          (incoming.status in statusTransitions[existing.status])
        );
    }

    match /tasks/{userId} {
      match /projects/{projectId} {
        match /user_tasks/{taskId} {
          allow read: if isSignedIn() && isProjectMember(get(/databases/$(database)/documents/tasks/$(userId)/projects/$(projectId)).data);
          allow create: if isSignedIn() && isValidTask() && isProjectMember(get(/databases/$(database)/documents/tasks/$(userId)/projects/$(projectId)).data);
          allow update: if isSignedIn() && isValidTaskUpdate() && isProjectMember(get(/databases/$(database)/documents/tasks/$(userId)/projects/$(projectId)).data);
          allow delete: if isSignedIn() && isProjectMember(get(/databases/$(database)/documents/tasks/$(userId)/projects/$(projectId)).data);
        }
      }
    }
  }
}

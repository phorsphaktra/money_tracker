rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId || (
          resource.data.preferences.allowMemberEditAllTransactions == true &&
          resource.data.preferences.invitedMembers.hasAny([request.auth.token.email])
        )
      );
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    match /stats/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function canInvitedMemberEditAll(userId) {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(userId)).data.preferences.allowMemberEditAllTransactions == true &&
        get(/databases/$(database)/documents/users/$(userId)).data.preferences.invitedMembers.hasAny([request.auth.token.email]);
    }

    match /monthly_tracker/{userId}/transactions/{transactionId} {
      allow read, write: if isOwner(userId) || canInvitedMemberEditAll(userId);
    }

        // Add savings rules
    match /monthly_tracker/{userId}/savings/{savingId} {
      allow read, write: if isOwner(userId) || canInvitedMemberEditAll(userId);
    }

    // Invitations
    function isInvitationOwnerOrInvitee() {
      return request.auth != null && (
        resource.data.inviteeEmail == request.auth.token.email ||
        resource.data.ownerId == request.auth.uid
      );
    }

    match /invitations/{invitationId} {
      allow read: if isInvitationOwnerOrInvitee();
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      // Allow the invitee to update the invitation status to 'accepted' or 'rejected'.
      // Only allow ownerId and inviteeEmail to remain unchanged and only allow changes to 'status' and 'acceptedAt'.
      allow update: if request.auth != null && resource.data.inviteeEmail == request.auth.token.email &&
        request.resource.data.ownerId == resource.data.ownerId &&
        request.resource.data.inviteeEmail == resource.data.inviteeEmail &&
        request.resource.data.status in ['pending', 'accepted', 'rejected'] &&
        request.resource.data.diff(resource.data).changedKeys().hasOnly(['status', 'acceptedAt']);
      allow delete: if false;
    }

    // Member Groups - Allow owners and invited members to access their group
    match /memberGroups/{ownerId} {
      allow read: if request.auth != null && (
        request.auth.uid == ownerId || 
        (resource.data.memberIds != null && resource.data.memberIds.hasAny([request.auth.uid])) ||
        get(/databases/$(database)/documents/users/$(ownerId)).data.preferences.invitedMembers.hasAny([request.auth.token.email])
      );
      allow create: if request.auth != null && request.auth.uid == ownerId;
      allow update: if request.auth != null && request.auth.uid == ownerId;
      allow delete: if false; // Prevent deletion of member groups
    }

    function isSignedIn() {
      return request.auth != null;
    }
    
    function isProjectMember(projectData) {
      return isSignedIn() && 
        (projectData.members.hasAny([request.auth.uid]) || 
         projectData.createdBy == request.auth.uid);
    }

    function isValidTask() {
      let incoming = request.resource.data;
      return incoming.title is string &&
        incoming.title.size() > 0 &&
        incoming.projectId is string &&
        incoming.status in ['initial', 'in_progress', 'review', 'completed', 'blocked'] &&
        incoming.priority in ['Low', 'Medium', 'High'];
    }

    function canDeleteTask() {
      let task = resource.data;
      return isSignedIn() && 
        (request.auth.uid == userId || 
         task.createdBy == request.auth.uid || 
         task.assignedTo == request.auth.uid);
    }

    match /tasks/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      match /projects/{projectId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId;
        allow update: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;

        match /tasks/{taskId} {
          allow read: if request.auth != null && request.auth.uid == userId;
          allow create: if request.auth != null && request.auth.uid == userId;
          allow update: if request.auth != null && request.auth.uid == userId;
          allow delete: if request.auth != null && request.auth.uid == userId;
        }
      }
    }
  }
}
